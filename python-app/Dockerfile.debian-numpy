FROM python:3.13-bookworm

WORKDIR /app

COPY requirements/backend-numpy.txt requirements/backend-numpy.txt
RUN pip install --no-cache-dir -r requirements/backend-numpy.txt

COPY . .

ENV PYTHONPATH=/app
ENV APP_DEBUG=false

EXPOSE 8000

CMD ["uvicorn", "spaceship.main:app", "--host", "0.0.0.0", "--port", "8000"]
